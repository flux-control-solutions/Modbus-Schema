{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    // Local agent tooling settings, not source.
    ".claude/",

    // Vendored lint plugin, formatted by its upstream.
    "tools/oxlint/anti-slop/"
  ],
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  }
}
