{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    // Local agent tooling settings, not source.
    ".claude/"
  ],
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  }
}
